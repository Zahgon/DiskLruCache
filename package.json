{
  "name": "disklrucache",
  "version": "2.0.3-SNAPSHOT",
  "description": "A disk-based implementaion of a least-recently used cache.",
  "author": "Jake Wharton <jakewharton@gmail.com>",
  "repository": "https://github.com/JakeWharton/DiskLruCache",
  "homepage": "https://github.com/JakeWharton/DiskLruCache/",
  "license": "Apache-2.0",
  "type": "commonjs",
  "keywords": [
    "cache",
    "lru",
    "disk",
    "typescript"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.2.7"
  }
}
